# ===================================================================
# Melo Spring Backend Environment Secrets (Template)
# Copy this file to .env and fill in your actual credentials.
# ===================================================================

# Bakong KHQR Open API
BAKONG_ACCOUNT_ID=your_account@bkrt
BAKONG_MERCHANT_NAME=Melo Music
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_TOKEN=your_bakong_bearer_token

# Spotify Web API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Groq AI Model
GROQ_API_KEY=your_groq_api_key

# Tavily AI Search
TAVILY_API_KEY=your_tavily_api_key

# Gmail SMTP Email OTP
EMAIL_USER=melonoreply@gmail.com
EMAIL_PASS=your_gmail_app_password

# Deezer Streaming ARL Cookie
DEEZER_ARL=your_deezer_arl_cookie

